# Build
VITE_BASE_PATH=/miss-badminton/
NODE_ENV=production

# Optional: error monitoring via Sentry. Leave empty to disable (no-op,
# the @sentry/react peer is never loaded). Set your DSN to activate.
VITE_SENTRY_DSN=

# Identifiant de mesure GA4 (`G-…`), propre à CETTE application : une propriété
# par site, sinon les audiences se mélangent. Absent, le bandeau de consentement
# ne rend rien et rien n'est mesuré — c'est le seul interrupteur.
VITE_GA_MEASUREMENT_ID=
